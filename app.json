{
  "expo": {
    "name": "Pharmacy Pocket",
    "slug": "pharmacy-pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pharmacypocket",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aqsama.pharmacypocket",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.aqsama.pharmacypocket",
      "adaptiveIcon": {
        "backgroundColor": "#103E3B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#103E3B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 112
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
